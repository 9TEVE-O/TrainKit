{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Wrapper for every event written to the JSONL event log.",
  "type": "object",
  "required": ["id", "timestamp", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique event identifier (UUID v4 recommended)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp."
    },
    "type": {
      "$ref": "event-type.schema.json"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data."
    }
  }
}
